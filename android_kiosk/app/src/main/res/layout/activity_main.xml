<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Primary Kiosk WebView displaying the A-X-L HUD -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <!-- Fallback / Connection Error Overlay -->
    <LinearLayout
        android:id="@+id/layoutOffline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2000000"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="A-X-L MASTER NON RAGGIUNGIBILE"
            android:textColor="#FF3B30"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTargetUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="http://192.168.1.100:8000/ui"
            android:textColor="#8E8E93"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnChangeIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#00FFCC"
            android:text="⚙️ Configura IP Master"
            android:textColor="#000000"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRetry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Riprova Connessione"
            android:textColor="#00FFCC" />
    </LinearLayout>

    <!-- Always Visible Floating Setup Button (Top-Right) -->
    <Button
        android:id="@+id/btnFloatingSetup"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:elevation="12dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:backgroundTint="#3300FFCC"
        android:text="⚙️ IP"
        android:textColor="#00FFCC"
        android:textSize="11sp" />

</FrameLayout>
