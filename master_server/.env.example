# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

#Default security mode on starting app
AXL_SECURITY_MODE=friendly

# Biometric Speaker Verification Threshold (calibrated via tools/calibrate_speaker.py)
AXL_SPEAKER_THRESHOLD=0.48

# OpenWakeWord Detection Threshold (calibrated to minimize false positives in conversational speech)
AXL_WAKEWORD_THRESHOLD=0.48

# Local Speech-to-Text (STT) Configuration (faster-whisper)
# Models: 'tiny' (ultra-fast ~250ms), 'base' (recommended default ~500ms on ThinkPad), 'small'
AXL_STT_MODEL=base
AXL_STT_DEVICE=cpu
AXL_STT_COMPUTE_TYPE=int8
AXL_STT_LANGUAGE=it
AXL_STT_CPU_THREADS=4

